{
  "expo": {
    "name": "حراج فيديو",
    "slug": "haraj-video",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.harajvideo.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.harajvideo.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "للسماح بتصوير مقاطع لإعلاناتك",
          "microphonePermission": "للسماح بتسجيل الصوت مع الفيديو"
        }
      ],
      "expo-secure-store",
      "expo-image"
    ],
    "scheme": "harajvideo",
    "newArchEnabled": true
  }
}
