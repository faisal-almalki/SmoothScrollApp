# Every variable this server reads. Required ones are checked at startup, so a
# missing value stops the container rather than surfacing as a 500 later.

# ---- required -------------------------------------------------------------

# Neon pooled connection string.
# console.neon.tech -> your project -> Connection Details -> Pooled connection
# The host must contain "-pooler".
DATABASE_URL="postgres://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Signing key for access tokens. Generate with:  openssl rand -base64 32
# Changing it signs everyone out, which is the intended way to revoke the lot.
JWT_SECRET=""

# ---- optional -------------------------------------------------------------

# Where the API is reachable, used to build absolute media URLs.
PUBLIC_BASE_URL="http://localhost:8787"

PORT="8787"
# "production" hides dev-only OTP codes and switches logs to JSON.
NODE_ENV="development"

# ---- object storage (photos and video) ------------------------------------
# S3-compatible, so Cloudflare R2, Backblaze B2 and S3 all work. Leave blank and
# the placeholder driver keeps the app and the verifier running with no account.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ---- machine-to-machine secrets -------------------------------------------
# Both endpoints are closed when their secret is unset, never open.
# Generate each with:  openssl rand -hex 32

# Presented as X-Transcoder-Secret on POST /videos/:id/ready.
TRANSCODER_SECRET=""

# Presented as X-Maintenance-Secret on POST /internal/maintenance.
MAINTENANCE_SECRET=""

# ---- push notifications ---------------------------------------------------
# The whole service-account JSON on one line. Firebase console -> Project
# settings -> Service accounts -> Generate new private key.
# Unset means notifications are skipped and logged; nothing breaks.
FCM_SERVICE_ACCOUNT_JSON=""
