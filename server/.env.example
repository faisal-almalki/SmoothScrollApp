# Neon pooled connection string.
# console.neon.tech -> your project -> Connection Details -> Pooled connection
# The host must contain "-pooler".
DATABASE_URL="postgres://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Signing key for access tokens. Generate with:  openssl rand -base64 32
JWT_SECRET=""

# Where the API is reachable, used to build absolute media URLs.
PUBLIC_BASE_URL="http://localhost:8787"
